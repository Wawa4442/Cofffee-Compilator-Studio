# ==========================================================
# CÓDIGO INTERMEDIO DE TRES DIRECCIONES (.ci)
# Coffee Compiler Studio - Compiladores II UAA
# ==========================================================
BEGIN_MAIN
# Declaración (int): a, b, c, creciente
    READ a
    READ b
    READ c
    t1 = a < b
    t2 = b < c
    t3 = t1 && t2
    IF_FALSE t3 GOTO L1
    creciente = 1
    GOTO L2
LABEL L1:
    creciente = 0
LABEL L2:
    WRITE creciente
END_MAIN
