# ==========================================================
# CÓDIGO INTERMEDIO DE TRES DIRECCIONES (.ci)
# Coffee Compiler Studio - Compiladores II UAA
# ==========================================================
BEGIN_MAIN
# Declaración (int): n, i, a, b, siguiente, resultado
    READ n
    t1 = n <= 1
    IF_FALSE t1 GOTO L1
    resultado = 0
    GOTO L2
LABEL L1:
    t2 = n == 2
    IF_FALSE t2 GOTO L3
    resultado = 1
    GOTO L4
LABEL L3:
    a = 0
    b = 1
    i = 3
LABEL L5:
    t3 = i <= n
    IF_FALSE t3 GOTO L6
    t4 = a + b
    siguiente = t4
    a = b
    b = siguiente
    t5 = i + 1
    i = t5
    GOTO L5
LABEL L6:
    resultado = b
LABEL L4:
LABEL L2:
    WRITE resultado
END_MAIN
