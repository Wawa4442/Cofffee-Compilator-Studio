# ==========================================================
# CÓDIGO INTERMEDIO DE TRES DIRECCIONES (.ci)
# Coffee Compiler Studio - Compiladores II UAA
# ==========================================================
BEGIN_MAIN
# Declaración (int): num, resultado
    READ num
    t1 = num > 0
    IF_FALSE t1 GOTO L1
    resultado = 0
    GOTO L2
LABEL L1:
    t2 = num < 0
    IF_FALSE t2 GOTO L3
    resultado = 1
    GOTO L4
LABEL L3:
    resultado = 2
LABEL L4:
LABEL L2:
    WRITE resultado
END_MAIN
